{
  "name": "anything2api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "UPSTREAM_BASE_URL": "http://122.51.245.211:8790",
    "STREAM_SHARDS": "16",
    "MAX_CONCURRENT_STREAMS_PER_SHARD": "4"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAM_RELAY",
        "class_name": "StreamRelayDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StreamRelayDurableObject"
      ]
    }
  ]
}
